+# Reseller-detail operational reads. Owner sessions are checked independently of
+# public API keys; no financial/lifecycle writes, delivery content or supplier HTTP.
+def _reseller_read_window(default_limit=25, clamp_limit=False):
+    try:
+        limit = int(request.args.get("limit", default_limit))
+        if clamp_limit:
+            limit = min(limit, 200)
+        offset = int(request.args.get("offset", 0))
+        if not 1 <= limit <= 200 or not 0 <= offset <= 2147483647:
+            raise ValueError
+        return limit, offset
+    except (TypeError, ValueError):
+        raise ValueError("limit must be 1–200 and offset must be non-negative") from None
+
+
+def _reseller_read_page(rows, limit, offset):
+    more = len(rows) > limit
+    return rows[:limit], {"has_more": more, "next_offset": offset + limit if more else None,
+                          "limit": limit, "offset": offset}
+
