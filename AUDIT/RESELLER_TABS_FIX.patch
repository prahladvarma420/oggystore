+    try:
+        limit, offset = _reseller_read_window()
+    except ValueError as exc:
+        return jsonify({"ok": False, "error": str(exc)}), 400
+    from urllib.parse import urlsplit
+    rows = q("SELECT id, url, enabled, created, updated FROM reseller_webhooks "
+             "WHERE reseller_id=? ORDER BY id DESC LIMIT ? OFFSET ?",
+             (res["id"], limit + 1, offset))
+    rows, pagination = _reseller_read_page(rows, limit, offset)
+    hooks = []
+    for row in rows:
+        # Legacy destinations may contain credentials in userinfo/path/query.
+        # Display the origin only, never the stored URL/signing secret.
+        try:
+            parts = urlsplit(row["url"])
+            host = parts.hostname or ""
+            if parts.scheme != "https" or not host:
+                raise ValueError
+            host = "[" + host + "]" if ":" in host else host
+            origin = "https://" + host + ((":" + str(parts.port)) if parts.port else "")
+        except ValueError:
+            origin = "Unavailable destination"
+        hooks.append({"webhook_id": "WHK-{:08d}".format(row["id"]),
+                      "destination_origin": origin, "enabled": bool(row["enabled"]),
+                      "created": row["created"], "updated": row["updated"]})
+    return jsonify({"ok": True, "webhooks": hooks, "pagination": pagination,
+                    "health": rdb.get_reseller_webhook_analytics(res["id"], days=30)})
+
