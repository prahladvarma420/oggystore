{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "install": {
      "commands": [
        "...",
        "PLAYWRIGHT_BROWSERS_PATH=0 /app/.venv/bin/python -m playwright install chromium"
      ]
    }
  },
  "deploy": {
    "variables": {
      "PLAYWRIGHT_BROWSERS_PATH": "0"
    },
    "aptPackages": [
      "libnss3",
      "libnspr4",
      "libatk1.0-0",
      "libatk-bridge2.0-0",
      "libcups2",
      "libdrm2",
      "libxkbcommon0",
      "libatspi2.0-0",
      "libxcomposite1",
      "libxdamage1",
      "libxfixes3",
      "libxrandr2",
      "libgbm1",
      "libasound2",
      "libpango-1.0-0",
      "libcairo2",
      "libx11-6",
      "libx11-xcb1",
      "libxcb1",
      "libxext6",
      "libglib2.0-0",
      "fonts-liberation"
    ]
  }
}
